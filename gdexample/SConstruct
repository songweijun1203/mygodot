#!/usr/bin/env python

import os

env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src"])
sources = []
for source_dir, _, filenames in os.walk("src"):
	for filename in sorted(filenames):
		if filename.endswith(".cpp"):
			sources.append(env.File(os.path.join(source_dir, filename)))
sources.sort(key=str)

objects = [
	env.SharedObject(
		os.path.join(
			"build",
			os.path.splitext(os.path.relpath(str(source), "src"))[0],
		),
		source=source,
	)
	for source in sources
]

if env["platform"] == "macos":
	output = "project/bin/libgdexample.macos.{}.dylib".format(env["target"])
else:
	output = "project/bin/libgdexample"

library = env.SharedLibrary(output, source=objects)
env.NoCache(library)
Default(library)
