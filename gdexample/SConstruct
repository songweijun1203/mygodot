#!/usr/bin/env python

env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src"])
sources = Glob("src/*.cpp")

if env["platform"] == "macos":
	output = "project/bin/libgdexample.macos.{}.dylib".format(env["target"])
else:
	output = "project/bin/libgdexample"

library = env.SharedLibrary(output, source=sources)
env.NoCache(library)
Default(library)
