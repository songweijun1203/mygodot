{
  "version": 4,
  "configurations": [
    {
      "name": "macOS SPX Debug",
      "compilerPath": "/usr/bin/clang++",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "compileCommands": "${workspaceFolder:mygodot}/.spx-build/compile_commands.json",
      "includePath": [
        "${workspaceFolder:mygodot}/godot_modules/spx",
        "${workspaceFolder:mygodot}/godot",
        "${workspaceFolder:mygodot}/gdexample/src",
        "${workspaceFolder:mygodot}/gdexample/godot-cpp/include",
        "${workspaceFolder:mygodot}/gdexample/godot-cpp/gen/include",
        "${workspaceFolder:mygodot}/gdexample/godot-cpp/gdextension"
      ],
      "browse": {
        "path": [
          "${workspaceFolder:mygodot}/godot_modules/spx",
          "${workspaceFolder:mygodot}/godot",
          "${workspaceFolder:mygodot}/gdexample/src",
          "${workspaceFolder:mygodot}/gdexample/godot-cpp/include",
          "${workspaceFolder:mygodot}/gdexample/godot-cpp/gen/include",
          "${workspaceFolder:mygodot}/gdexample/godot-cpp/gdextension"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
